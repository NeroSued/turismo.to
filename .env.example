# Copie para .env.local e preencha. Nunca versione o arquivo preenchido.
# Valores locais: rode `npx supabase status` depois de `npx supabase start`.

# Domínio raiz. Local: localhost:3000 (subdomínios *.localhost funcionam sem DNS).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Supabase (públicos: URL e chave publishable, nunca a secreta)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (service_role). Só no servidor, usada por src/lib/supabase/privilegiado.ts.
SUPABASE_SECRET_KEY=

# Permite escolher o município com ?municipio=<slug>. Apenas Development e Preview.
# Em produção, deixe ausente.
ALLOW_TENANT_OVERRIDE=true
